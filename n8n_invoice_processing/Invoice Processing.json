    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $json.output;\nconst issues = [];\nconst round = v => Math.round(v * 100) / 100;\nconst num = v => (typeof v === 'number' ? v : parseFloat(v));\n\n// Required fields\nfor (const f of ['vendor', 'invoice_number', 'invoice_date', 'total']) {\n  if (d[f] === null || d[f] === undefined || d[f] === '') issues.push(`missing ${f}`);\n}\n\n// Math checks\nconst items = Array.isArray(d.line_items) ? d.line_items : [];\nconst itemsSum = round(items.reduce((s, i) => s + (num(i.amount) || 0), 0));\nconst subtotal = num(d.subtotal);\nconst tax = num(d.tax) || 0;\nconst total = num(d.total);\n\nif (!isNaN(subtotal) && items.length && Math.abs(itemsSum - subtotal) > 0.02) {\n  issues.push(`line items sum to ${itemsSum} but subtotal is ${subtotal}`);\n}\nif (!isNaN(subtotal) && !isNaN(total) && Math.abs(round(subtotal + tax) - total) > 0.02) {\n  issues.push(`subtotal + tax = ${round(subtotal + tax)} but total is ${total}`);\n}\n\n// Date checks (YYYY-MM-DD strings compare correctly)\nif (d.invoice_date && !/^\\d{4}-\\d{2}-\\d{2}$/.test(d.invoice_date)) issues.push('invoice_date is not YYYY-MM-DD');\nif (d.invoice_date && d.due_date && d.due_date < d.invoice_date) issues.push('due date is before invoice date');\n\nreturn {\n  json: {\n    ...d,\n    line_items: JSON.stringify(items),\n    source_file: $('On form submission').item.binary?.invoice?.fileName || '',\n    issues\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
