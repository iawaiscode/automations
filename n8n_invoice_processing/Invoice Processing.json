        "jsonSchemaExample": "{\"vendor\":\"Acme Supplies\",\"invoice_number\":\"INV-1001\",\"invoice_date\":\"2026-10-02\",\"due_date\":\"2026-11-01\",\"currency\":\"USD\",\"subtotal\":495.00,\"tax\":49.50,\"total\":544.50,\"line_items\":[{\"description\":\"Boxes\",\"quantity\":200,\"unit_price\":1.25,\"amount\":250.00}]}",
        "options": {
          "systemPromptTemplate": "Extract invoice data. Dates must be YYYY-MM-DD. Numbers must be plain numbers with no currency symbols. If a field is missing, return null. Never guess or calculate values that aren’t printed on the invoice."
        }
