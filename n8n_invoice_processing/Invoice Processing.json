        "jsCode": "const v = $('Validate').item.json;\nconst issues = [...v.issues];\nif ($json.invoice_number) issues.push('duplicate invoice already recorded');\n\nreturn {\n  json: {\n    ...v,\n    issues,\n    reason: issues.join('; '),\n    route: issues.length ? 'review' : 'ok'\n  }\n};"
