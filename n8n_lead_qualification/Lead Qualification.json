    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const f = $json;\nconst email = (f.email || '').trim().toLowerCase();\nconst message = (f.message || '').trim();\nconst domain = email.split('@')[1] || '';\n\nconst disposable = ['mailinator.com', 'tempmail.com', '10minutemail.com', 'guerrillamail.com'];\nconst freeDomains = ['gmail.com', 'yahoo.com', 'outlook.com', 'hotmail.com', 'icloud.com'];\nconst hardFlags = [];\nconst softFlags = [];\n\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) hardFlags.push('invalid email');\nif (disposable.includes(domain)) hardFlags.push('disposable email');\nif (/\\b(seo services|backlinks|casino|crypto|guest post)\\b/i.test(message)) hardFlags.push('spam keywords');\nif ((message.match(/https?:\\/\\/|www\\./gi) || []).length >= 2) hardFlags.push('multiple links');\nif (message.length < 20) softFlags.push('very short message');\n\nreturn {\n  json: {\n    name: (f.name || '').trim(),\n    email,\n    company: (f.company || '').trim(),\n    website: (f.website || '').trim(),\n    service: f.service || '',\n    budget: f.budget || '',\n    timeline: f.timeline || '',\n    message,\n    free_email: freeDomains.includes(domain),\n    flags: [...hardFlags, ...softFlags],\n    is_spam: hardFlags.length > 0\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -144,
